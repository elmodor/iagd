<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IAGrim.UI.StashPicker"
        Width="567"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="StashPicker"
        Tag="iatag_ui_stashpicker"
        KeyDown="StashPicker_KeyDown">

    <Border BorderBrush="{DynamicResource IAGrimWindowBorder}" BorderThickness="1">
    <Grid Margin="6" RowDefinitions="Auto,Auto" RowSpacing="6">
        <GroupBox Grid.Row="0" Header="Mod selection" Tag="iatag_ui_modselection">
            <Grid ColumnDefinitions="*,Auto" Margin="6">
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="HelpLink" HorizontalAlignment="Right" Margin="0,0,0,8" TextDecorations="Underline" Cursor="Hand" Tag="iatag_ui_why_showing_stashpicker" PointerPressed="helpLink_LinkClicked" Text="Why do I need to choose?" />
                    <StackPanel x:Name="ModSelectionPanel" />
                </StackPanel>

                <Image Grid.Column="1" x:Name="ChestImage" Margin="12,0,0,0" Width="103" Height="103" Stretch="Uniform" />
            </Grid>
        </GroupBox>

        <Button Grid.Row="1"
                x:Name="ButtonTransfer" HorizontalAlignment="Stretch" Tag="iatag_ui_transfer" Content="Transfer" Click="buttonTransfer_Click" />
    </Grid>
    </Border>
</Window>
