<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IAGrim.UI.Popups.ImportExport.Panels.ImportMode"
             Loaded="ImportMode_Loaded">

    <Grid Margin="14" ColumnDefinitions="180,*,*" ColumnSpacing="7">
        <Border Grid.Column="0" BorderThickness="1">
            <Grid RowDefinitions="40,*">
                <Border Grid.Row="0">
                    <TextBlock Text="File Type" Tag="iatag_ui_import_filetype" FontSize="20" VerticalAlignment="Center" Margin="8,0" />
                </Border>

                <Grid Grid.Row="1" Margin="18" RowDefinitions="Auto,Auto,*">
                    <RadioButton x:Name="radioIAStash" Tag="iatag_ui_iastash" Content="IA Stash" IsChecked="True" PropertyChanged="radioIAStash_CheckedChanged" />
                    <RadioButton Grid.Row="1" x:Name="radioGDStash" Tag="iatag_ui_gdstash" Content="GD Stash" Margin="0,8,0,0" PropertyChanged="radioGDStash_CheckedChanged" />
                    <Button Grid.Row="2" x:Name="helpRestoreBackup" Tag="iatag_ui_questionmark" Content="?" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="helpRestoreBackup_Click" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="1" BorderThickness="1">
            <Grid RowDefinitions="40,*">
                <Border Grid.Row="0">
                    <TextBlock Text="Stash File" Tag="iatag_ui_import_stashfile" FontSize="20" VerticalAlignment="Center" Margin="8,0" />
                </Border>
                <Grid Grid.Row="1" Margin="18">
                    <Button x:Name="buttonBrowse" Tag="iatag_ui_browse" Content="Browse.." HorizontalAlignment="Stretch" VerticalAlignment="Top" Click="buttonBrowse_Click" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="2" BorderThickness="1">
            <Grid RowDefinitions="40,*">
                <Border Grid.Row="0">
                    <TextBlock Text="Import" Tag="iatag_ui_import_import" FontSize="20" VerticalAlignment="Center" Margin="8,0" />
                </Border>
                <StackPanel Grid.Row="1" Margin="18" Spacing="12">
                    <ComboBox x:Name="cbItemSelection" />
                    <Button x:Name="buttonImport" Tag="iatag_ui_import" Content="Import" HorizontalAlignment="Stretch" Click="buttonImport_Click" />
                    <ProgressBar x:Name="progressBar1" Minimum="0" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
