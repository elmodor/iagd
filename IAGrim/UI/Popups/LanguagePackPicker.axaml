<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IAGrim.UI.LanguagePackPicker"
        SizeToContent="WidthAndHeight"
        MinWidth="500"
        MinHeight="300"
        MaxWidth="800"
        MaxHeight="700"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Change Language"
        Loaded="LanguagePackPicker_Loaded"
        KeyDown="LanguagePackPicker_KeyDown">

    <Border BorderBrush="{DynamicResource IAGrimWindowBorder}" BorderThickness="1">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
        <Border Grid.Row="0" BorderBrush="#D0D0D0" BorderThickness="1" Padding="16">
            <Grid RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Text="Language Selection" Tag="iatag_ui_language_selection" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                <ScrollViewer Grid.Row="1" MaxHeight="500" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="languagePanel" Spacing="8" />
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" x:Name="lblWarning" Tag="iatag_ui_language_change_warning" Text="iatag_ui_language_change_warning" TextWrapping="Wrap" />
        <Button Grid.Row="2" x:Name="buttonSelect" Tag="iatag_ui_change_language" Content="Change Language" HorizontalAlignment="Stretch" MinHeight="40" Click="buttonSelect_Click" />
    </Grid>
    </Border>
</Window>
