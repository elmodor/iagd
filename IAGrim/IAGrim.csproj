<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Days since 2000-01-01, floored (matches how .net framework's 1.4.* build stamp worked) -->
	<BuildDateTimeUtc>$([System.Math]::Floor($([System.DateTime]::Now.Subtract($([System.DateTime]::new(2000,1,1, 0, 0, 0))).TotalDays)))</BuildDateTimeUtc>
	<VersionRevision>$([System.Convert]::ToUInt16($([MSBuild]::Divide($([System.DateTime]::Now.TimeOfDay.TotalSeconds),2))))</VersionRevision>
	<!-- Revision is 2-second ticks since midnight: 0..43199, always rendered as 5 digits -->
	<VersionRevisionPadded>$([System.String]::Format('{0:00000}', $([System.Convert]::ToInt32($(VersionRevision)))))</VersionRevisionPadded>
    <!--
      Two spellings of the same version, deliberately:
        Version              -> FileVersion/AssemblyVersion, a numeric win32 resource. CANNOT be zero-padded.
        InformationalVersion -> a string, IS zero-padded, and is what the git tags are cut from.
      So the revision is four or five digits wide depending on which one you read. Never compare these as
      strings ("9500" sorts above "11000"); use IAGrim.Utilities.VersionUtility, which compares numerically.
    -->
    <Version>1.5.$(BuildDateTimeUtc).$(VersionRevision)</Version>
    <InformationalVersion>1.5.$(BuildDateTimeUtc).$(VersionRevisionPadded)</InformationalVersion>
    <AssemblyInformationalVersion>$(InformationalVersion)</AssemblyInformationalVersion>

    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
	<RuntimeIdentifier>linux-x64</RuntimeIdentifier>
	<SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

